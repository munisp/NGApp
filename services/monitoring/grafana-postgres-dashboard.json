{
  "dashboard": {
    "title": "PostgreSQL Scaling Monitor",
    "tags": ["postgresql", "pgbouncer", "scaling"],
    "timezone": "utc",
    "refresh": "10s",
    "panels": [
      {
        "title": "Connection Pool (PgBouncer)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {"expr": "pgbouncer_pools_server_active_connections", "legendFormat": "Active"},
          {"expr": "pgbouncer_pools_server_idle_connections", "legendFormat": "Idle"},
          {"expr": "pgbouncer_pools_client_waiting_connections", "legendFormat": "Waiting"}
        ]
      },
      {
        "title": "Query Latency (p50/p95/p99)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {"expr": "histogram_quantile(0.50, rate(pg_query_duration_seconds_bucket[5m]))", "legendFormat": "p50"},
          {"expr": "histogram_quantile(0.95, rate(pg_query_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
          {"expr": "histogram_quantile(0.99, rate(pg_query_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
        ]
      },
      {
        "title": "Replication Lag",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {"expr": "pg_replication_lag_bytes", "legendFormat": "{{instance}}"}
        ]
      },
      {
        "title": "Queries per Second (Primary vs Replicas)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {"expr": "rate(pg_stat_statements_calls_total{role=\"primary\"}[5m])", "legendFormat": "Primary QPS"},
          {"expr": "rate(pg_stat_statements_calls_total{role=\"replica\"}[5m])", "legendFormat": "Replica QPS"}
        ]
      },
      {
        "title": "Cache Hit Ratio",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {"expr": "pg_stat_database_blks_hit / (pg_stat_database_blks_hit + pg_stat_database_blks_read) * 100", "legendFormat": "Hit %"}
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 90},
                {"color": "green", "value": 99}
              ]
            }
          }
        }
      },
      {
        "title": "Workload Isolation (Request Priority)",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {"expr": "sum(rate(http_requests_total{priority_tier=\"critical\"}[5m]))", "legendFormat": "Critical"},
          {"expr": "sum(rate(http_requests_total{priority_tier=\"high\"}[5m]))", "legendFormat": "High"},
          {"expr": "sum(rate(http_requests_total{priority_tier=\"normal\"}[5m]))", "legendFormat": "Normal"},
          {"expr": "sum(rate(http_requests_total{priority_tier=\"background\"}[5m]))", "legendFormat": "Background"}
        ]
      },
      {
        "title": "Slow Queries (>500ms)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {"expr": "pg_stat_statements_mean_exec_time_ms > 500", "legendFormat": "Count"}
        ]
      },
      {
        "title": "Rate Limiter Stats (Backfills)",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
        "targets": [
          {"expr": "rate_limiter_total_ops", "legendFormat": "{{limiter}}"},
          {"expr": "rate_limiter_rejected", "legendFormat": "{{limiter}} rejected"}
        ]
      },
      {
        "title": "Database Size",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {"expr": "pg_database_size_bytes{datname=\"fintech\"}", "legendFormat": "Size"}
        ],
        "fieldConfig": {
          "defaults": {"unit": "bytes"}
        }
      }
    ]
  }
}
