# EscrowProtect API - Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# DATABASE & PERSISTENCE (Required in Production)
# ============================================

# PostgreSQL connection string (required in production)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=sqlite+aiosqlite:///./escrow.db

# Redis connection string (required for multi-replica deployments)
REDIS_URL=redis://localhost:6379

# TigerBeetle addresses for ledger (required for financial transactions)
TIGERBEETLE_ADDRESSES=localhost:3000

# ============================================
# PRODUCTION MODE FLAGS
# ============================================

# Enable production mode (enforces strict requirements)
PRODUCTION_MODE=false

# Require PostgreSQL (fail if not connected)
REQUIRE_POSTGRES=false

# Require Redis (fail if not connected)
REQUIRE_REDIS=false

# Require TigerBeetle (fail if not connected)
REQUIRE_TIGERBEETLE=false

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# JWT secret key (required - generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT access token expiry in minutes (default: 30)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT refresh token expiry in days (default: 7)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API key header name (default: X-API-Key)
API_KEY_HEADER=X-API-Key

# Admin API key for privileged operations
ADMIN_API_KEY=

# Require authentication for all endpoints
REQUIRE_AUTH=true

# Rate limiting (requests per window)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# PAYMENT PROVIDER WEBHOOKS
# ============================================

# Paystack webhook secret
PAYSTACK_SECRET_KEY=

# Flutterwave webhook secret
FLUTTERWAVE_WEBHOOK_SECRET=

# Bank webhook secret
BANK_WEBHOOK_SECRET=

# ============================================
# NIBSS / BANK INTEGRATION
# ============================================

# NIBSS API base URL
NIBSS_BASE_URL=https://api.nibss-plc.com.ng

# NIBSS API credentials
NIBSS_API_KEY=
NIBSS_SECRET_KEY=
NIBSS_INSTITUTION_CODE=999999

# Core banking system integration
CORE_BANKING_URL=
CORE_BANKING_API_KEY=
CORE_BANKING_USERNAME=
CORE_BANKING_PASSWORD=

# Virtual account configuration
VIRTUAL_ACCOUNT_PREFIX=999
ESCROW_POOL_ACCOUNT=

# Settlement configuration
SETTLEMENT_CUTOFF_TIME=15:00
SAME_DAY_SETTLEMENT=true

# ============================================
# INSURANCE INTEGRATION
# ============================================

# Insurance provider API
INSURER_API_URL=https://api.insurer.ng
INSURER_API_KEY=
INSURER_SECRET_KEY=
INSURER_AGENT_CODE=
INSURER_PRODUCT_CODE=ESCROW-PROTECT-001

# Protection fund configuration
PROTECTION_FUND_ENABLED=true
PROTECTION_FUND_RESERVE=10000000
PROTECTION_FUND_MAX_CLAIM=500000

# Premium rates
BASE_PREMIUM_RATE=0.015
MIN_PREMIUM=100
MAX_PREMIUM_RATE=0.05

# Risk categories (comma-separated)
HIGH_RISK_CATEGORIES=electronics,phones,laptops,jewelry
HIGH_RISK_LOCATIONS=lagos,port_harcourt,kano

# ============================================
# OCR & NLP MODELS
# ============================================

# OCR model for document processing
OCR_MODEL=deepseek-vl

# NLP model for text analysis
NLP_MODEL=bert-base-multilingual

# ============================================
# EVENT STREAMING (Kafka)
# ============================================

# Kafka bootstrap servers (comma-separated)
# Leave empty to use in-memory publisher for development
KAFKA_BOOTSTRAP_SERVERS=

# ============================================
# LAKEHOUSE / ANALYTICS (Trino)
# ============================================

# Trino host for analytics queries
TRINO_HOST=localhost

# Trino port
TRINO_PORT=8080

# ============================================
# WHATSAPP BUSINESS API (Optional)
# ============================================

# WhatsApp Business API credentials
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ============================================
# SMS GATEWAY (Optional)
# ============================================

# SMS provider credentials
SMS_API_KEY=
SMS_SENDER_ID=EscrowNG

# ============================================
# USSD GATEWAY (Optional)
# ============================================

# USSD provider credentials
USSD_SERVICE_CODE=*384*123#
USSD_API_KEY=

# ============================================
# MIDDLEWARE INTEGRATIONS
# ============================================

# Require Kafka (fail if not connected in production)
REQUIRE_KAFKA=false

# Require Temporal (fail if not connected in production)
REQUIRE_TEMPORAL=false

# ============================================
# TEMPORAL WORKFLOW ENGINE
# ============================================

# Temporal server address
TEMPORAL_ADDRESS=localhost:7233

# Temporal namespace
TEMPORAL_NAMESPACE=escrow-platform

# Temporal task queue
TEMPORAL_TASK_QUEUE=escrow-workflows

# ============================================
# DAPR SERVICE MESH
# ============================================

# Dapr HTTP port
DAPR_HTTP_PORT=3500

# Dapr gRPC port
DAPR_GRPC_PORT=50001

# Dapr app ID
DAPR_APP_ID=escrow-api

# ============================================
# OPENSEARCH CENTRALIZED LOGGING
# ============================================

# OpenSearch hosts (comma-separated)
OPENSEARCH_HOSTS=localhost:9200

# OpenSearch index prefix
OPENSEARCH_INDEX_PREFIX=escrow

# OpenSearch username (optional)
OPENSEARCH_USERNAME=

# OpenSearch password (optional)
OPENSEARCH_PASSWORD=

# ============================================
# PERMIFY AUTHORIZATION
# ============================================

# Permify server URL
PERMIFY_URL=http://localhost:3476

# Permify tenant ID
PERMIFY_TENANT_ID=escrow-platform

# ============================================
# FLUVIO EVENT STREAMING
# ============================================

# Fluvio cluster address
FLUVIO_CLUSTER=localhost:9003

# Fluvio topic prefix
FLUVIO_TOPIC_PREFIX=escrow

# ============================================
# LAKEHOUSE DATA PLATFORM
# ============================================

# Lakehouse storage path (S3 or local)
LAKEHOUSE_STORAGE_PATH=s3://escrow-lakehouse

# Delta Lake path
DELTA_LAKE_PATH=s3://escrow-lakehouse/delta

# Iceberg catalog URI
ICEBERG_CATALOG_URI=thrift://localhost:9083

# Spark master URL
SPARK_MASTER=local[*]

# Flink job manager address
FLINK_JOBMANAGER=localhost:8081

# Ray cluster address
RAY_ADDRESS=auto

# ============================================
# APISIX GATEWAY
# ============================================

# APISIX admin API key
APISIX_ADMIN_KEY=

# APISIX admin URL
APISIX_ADMIN_URL=http://localhost:9180

# ============================================
# OPENAPPSEC WAF
# ============================================

# OpenAppSec mode (detect or prevent)
OPENAPPSEC_MODE=detect

# ============================================
# WAZUH SIEM
# ============================================

# Wazuh manager address
WAZUH_MANAGER_ADDRESS=localhost:1514

# Wazuh API URL
WAZUH_API_URL=https://localhost:55000

# Wazuh API credentials
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=

# ============================================
# OPENCTI THREAT INTELLIGENCE
# ============================================

# OpenCTI URL
OPENCTI_URL=http://localhost:8080

# OpenCTI API token
OPENCTI_TOKEN=

# ============================================
# KUBECOST
# ============================================

# Kubecost URL
KUBECOST_URL=http://localhost:9090
