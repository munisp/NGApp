{
  "info": {
    "name": "Document Intelligence - tRPC API",
    "description": "Comprehensive Postman collection for testing the Node.js tRPC backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "document-intelligence-ui"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trpc/auth.me",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "auth.me"]
            },
            "description": "Get the currently authenticated user information"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/trpc/auth.logout",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "auth.logout"]
            },
            "description": "Logout the current user and clear session"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "List All Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trpc/documents.list",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "documents.list"]
            },
            "description": "Get all documents for the authenticated user"
          },
          "response": []
        },
        {
          "name": "Get Document by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trpc/documents.get?input={\"id\":1}",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "documents.get"],
              "query": [
                {
                  "key": "input",
                  "value": "{\"id\":1}",
                  "description": "Document ID"
                }
              ]
            },
            "description": "Get a specific document by ID with OCR results"
          },
          "response": []
        },
        {
          "name": "Upload Single Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"passport.jpg\",\n  \"category\": \"citizenship_identity\",\n  \"fileData\": \"<BASE64_ENCODED_FILE>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/trpc/documents.upload",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "documents.upload"]
            },
            "description": "Upload a single document for OCR processing"
          },
          "response": []
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/trpc/documents.delete",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "documents.delete"]
            },
            "description": "Delete a document by ID"
          },
          "response": []
        },
        {
          "name": "Export Document Results (JSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trpc/documents.export?input={\"id\":1,\"format\":\"json\"}",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "documents.export"],
              "query": [
                {
                  "key": "input",
                  "value": "{\"id\":1,\"format\":\"json\"}"
                }
              ]
            },
            "description": "Export document OCR results as JSON"
          },
          "response": []
        },
        {
          "name": "Export Document Results (CSV)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trpc/documents.export?input={\"id\":1,\"format\":\"csv\"}",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "documents.export"],
              "query": [
                {
                  "key": "input",
                  "value": "{\"id\":1,\"format\":\"csv\"}"
                }
              ]
            },
            "description": "Export document OCR results as CSV"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Batch Processing",
      "item": [
        {
          "name": "List All Batches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trpc/batches.list",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "batches.list"]
            },
            "description": "Get all batch uploads for the authenticated user"
          },
          "response": []
        },
        {
          "name": "Get Batch by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trpc/batches.get?input={\"id\":1}",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "batches.get"],
              "query": [
                {
                  "key": "input",
                  "value": "{\"id\":1}"
                }
              ]
            },
            "description": "Get batch details with all documents and their statuses"
          },
          "response": []
        },
        {
          "name": "Create Batch Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Health Insurance Documents - January 2025\",\n  \"files\": [\n    {\n      \"filename\": \"insurance_card_front.jpg\",\n      \"category\": \"health_coverage\",\n      \"fileData\": \"<BASE64_ENCODED_FILE_1>\"\n    },\n    {\n      \"filename\": \"insurance_card_back.jpg\",\n      \"category\": \"health_coverage\",\n      \"fileData\": \"<BASE64_ENCODED_FILE_2>\"\n    },\n    {\n      \"filename\": \"coverage_letter.pdf\",\n      \"category\": \"health_coverage\",\n      \"fileData\": \"<BASE64_ENCODED_FILE_3>\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/trpc/batches.create",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "batches.create"]
            },
            "description": "Create a new batch upload with multiple documents"
          },
          "response": []
        },
        {
          "name": "Retry Failed Documents in Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/trpc/batches.retryFailed",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "batches.retryFailed"]
            },
            "description": "Retry all failed documents in a batch"
          },
          "response": []
        },
        {
          "name": "Delete Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/trpc/batches.delete",
              "host": ["{{base_url}}"],
              "path": ["api", "trpc", "batches.delete"]
            },
            "description": "Delete a batch and all its documents"
          },
          "response": []
        }
      ]
    },
