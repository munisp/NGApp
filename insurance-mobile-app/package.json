{
  "name": "insurance-mobile-app",
  "version": "1.0.0",
  "description": "InsurePortal Mobile App - iOS and Android",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest",
    "lint": "eslint .",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace InsurePortal.xcworkspace -scheme InsurePortal -configuration Release"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.2",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "react-native-screens": "^3.29.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-gesture-handler": "^2.14.1",
    "@tanstack/react-query": "^5.17.9",
    "axios": "^1.6.5",
    "react-native-vector-icons": "^10.0.3",
    "react-native-paper": "^5.11.6",
    "react-native-async-storage": "^1.21.0",
    "react-native-biometrics": "^3.0.1",
    "react-native-push-notification": "^8.1.1",
    "react-native-camera": "^4.2.1",
    "react-native-document-picker": "^9.1.1",
    "react-native-image-picker": "^7.1.0",
    "react-native-pdf": "^6.7.4",
    "react-native-share": "^10.0.2",
    "react-native-webview": "^13.6.4",
    "date-fns": "^3.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@babel/runtime": "^7.23.7",
    "@react-native/babel-preset": "^0.73.19",
    "@react-native/eslint-config": "^0.73.2",
    "@react-native/metro-config": "^0.73.3",
    "@react-native/typescript-config": "^0.73.1",
    "@types/react": "^18.2.48",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
