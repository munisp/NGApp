# Sample configuration for local development
SERVICE_NAME=actuarial-data-transformer-local
ENVIRONMENT=local
LOG_LEVEL=debug

# Kafka settings - replace with your local Kafka broker
KAFKA_BROKERS=localhost:9092
KAFKA_INPUT_TOPIC=openimis.claims.events
KAFKA_OUTPUT_TOPIC=actuarial.aggregations
KAFKA_GROUP_ID=actuarial-transformer-group-local

# Data settings
LATE_DATA_THRESHOLD=24h
ENRICHMENT_API_URL=http://localhost:8081/api/v1/context # Mock enrichment service URL
