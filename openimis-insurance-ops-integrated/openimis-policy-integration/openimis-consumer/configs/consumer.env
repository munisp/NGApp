# Configuration for OpenIMIS Consumer Service

# Kafka Broker Address (e.g., "localhost:9092")
KAFKA_BROKER="kafka:9092"

# Kafka Topic for Policy Events
KAFKA_TOPIC="policy-events"

# Kafka Consumer Group ID
KAFKA_GROUP="openimis-actuarial-group"

# Prometheus Metrics Port
METRICS_PORT="8081"

# Database Connection String (e.g., "postgres://user:pass@host:port/dbname?sslmode=disable")
DB_CONN_STR="sqlite3://openimis_actuarial.db"
