{
  "name": "insurance-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Insurance Platform — Native Mobile App (iOS/Android)",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "build:android:release": "cd android && ./gradlew bundleRelease",
    "build:ios:release": "xcodebuild -workspace ios/InsuranceMobile.xcworkspace -scheme InsuranceMobile -configuration Release archive"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.74.3",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/drawer": "^6.6.15",
    "react-native-screens": "^3.32.0",
    "react-native-safe-area-context": "^4.10.5",
    "react-native-gesture-handler": "^2.17.1",
    "react-native-reanimated": "^3.13.0",
    "@reduxjs/toolkit": "^2.2.7",
    "react-redux": "^9.1.2",
    "redux-persist": "^6.0.0",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "react-native-keychain": "^8.2.0",
    "react-native-biometrics": "^3.0.1",
    "@react-native-community/netinfo": "^11.3.2",
    "react-native-push-notification": "^8.1.1",
    "@notifee/react-native": "^9.0.0",
    "react-query": "^3.39.3",
    "axios": "^1.7.2",
    "react-native-mmkv": "^2.12.2",
    "react-native-camera": "^4.2.1",
    "react-native-image-picker": "^7.1.2",
    "react-native-document-picker": "^9.3.1",
    "react-native-pdf": "^6.7.4",
    "react-native-maps": "^1.14.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-svg": "^15.4.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-paper": "^5.12.3",
    "react-native-modal": "^13.0.1",
    "react-native-toast-message": "^2.2.0",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-fast-image": "^8.6.3",
    "react-native-share": "^10.1.3",
    "react-native-fs": "^2.20.0",
    "react-native-permissions": "^4.1.5",
    "react-native-localize": "^3.1.0",
    "i18next": "^23.12.2",
    "react-i18next": "^15.0.1",
    "date-fns": "^3.6.0",
    "zod": "^3.23.8",
    "react-hook-form": "^7.52.2",
    "@hookform/resolvers": "^3.9.0",
    "react-native-splash-screen": "^3.3.0",
    "react-native-config": "^1.5.1",
    "react-native-code-push": "^8.3.0",
    "@unleash/proxy-client-react-native": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.9",
    "@babel/preset-env": "^7.24.8",
    "@babel/runtime": "^7.24.8",
    "@react-native/babel-preset": "0.74.87",
    "@react-native/eslint-config": "0.74.87",
    "@react-native/metro-config": "0.74.87",
    "@react-native/typescript-config": "0.74.87",
    "@types/react": "^18.3.3",
    "@types/react-native": "^0.73.0",
    "@types/jest": "^29.5.12",
    "typescript": "5.0.4",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "babel-jest": "^29.7.0",
    "@testing-library/react-native": "^12.5.1",
    "detox": "^20.25.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterFramework": ["@testing-library/react-native/extend-expect"],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-.*)/)"
    ]
  }
}
