<!--
  Wazuh Custom Rules for Python Workflow Orchestrator Security Monitoring
  Rule ID range: 101000-101099 (workflow orchestrator rules)
-->

<group name="workflow-orchestrator,application,temporal,">

  <!-- Base rule for Workflow Orchestrator service -->
  <rule id="101000" level="0">
    <decoded_as>workflow-orchestrator-json</decoded_as>
    <description>Workflow Orchestrator service event</description>
  </rule>

  <!-- ========================================
       Authentication and Authorization Failures
       ======================================== -->

  <!-- Single authentication failure -->
  <rule id="101001" level="5">
    <if_sid>101000</if_sid>
    <decoded_as>workflow-orchestrator-auth-failure</decoded_as>
    <description>Workflow Orchestrator: Authentication failure from $(srcip)</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Multiple authentication failures (brute force) -->
  <rule id="101002" level="10" frequency="5" timeframe="300">
    <if_matched_sid>101001</if_matched_sid>
    <same_source_ip />
    <description>Workflow Orchestrator: Multiple authentication failures from $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,brute_force,pci_dss_11.4,pci_dss_10.2.4,pci_dss_10.2.5,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_SI.4,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Invalid API key -->
  <rule id="101003" level="6">
    <if_sid>101000</if_sid>
    <decoded_as>workflow-orchestrator-invalid-api-key</decoded_as>
    <description>Workflow Orchestrator: Invalid API key from $(srcip)</description>
    <group>authentication_failed,api_abuse,pci_dss_10.2.4,gdpr_IV_35.7.d,nist_800_53_AU.14,tsc_CC6.1,tsc_CC6.8,</group>
  </rule>

  <!-- Multiple invalid API key attempts -->
  <rule id="101004" level="10" frequency="5" timeframe="180">
    <if_matched_sid>101003</if_matched_sid>
    <same_source_ip />
    <description>Workflow Orchestrator: Multiple invalid API key attempts from $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,api_abuse,pci_dss_11.4,gdpr_IV_35.7.d,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,</group>
  </rule>

  <!-- Privilege escalation attempt -->
  <rule id="101005" level="12">
    <if_sid>101000</if_sid>
    <decoded_as>workflow-orchestrator-privilege-escalation</decoded_as>
    <description>Workflow Orchestrator: Privilege escalation attempt detected</description>
    <mitre>
      <id>T1068</id>
      <id>T1548</id>
    </mitre>
    <group>privilege_escalation,attack,pci_dss_10.2.2,pci_dss_10.2.5,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.6,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,</group>
  </rule>

  <!-- ========================================
       Unauthorized Workflow Execution
       ======================================== -->

  <!-- Unauthorized workflow execution attempt -->
  <rule id="101010" level="8">
    <if_sid>101000</if_sid>
    <field name="msg">unauthorized workflow execution</field>
    <description>Workflow Orchestrator: Unauthorized workflow execution attempt - $(workflow_type)</description>
    <mitre>
      <id>T1204</id>
    </mitre>
    <group>unauthorized_execution,pci_dss_10.2.5,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.3,tsc_CC6.1,tsc_CC6.8,</group>
  </rule>

  <!-- Multiple unauthorized workflow execution attempts -->
  <rule id="101011" level="12" frequency="3" timeframe="300">
    <if_matched_sid>101010</if_matched_sid>
    <same_source_ip />
    <description>Workflow Orchestrator: Multiple unauthorized workflow execution attempts from $(srcip)</description>
    <mitre>
      <id>T1204</id>
      <id>T1078</id>
    </mitre>
    <group>unauthorized_execution,attack,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_SI.4,nist_800_53_AC.3,tsc_CC6.1,tsc_CC6.8,</group>
  </rule>

  <!-- Suspicious workflow type execution -->
  <rule id="101012" level="9">
    <if_sid>101000</if_sid>
    <decoded_as>workflow-orchestrator-suspicious-workflow</decoded_as>
    <description>Workflow Orchestrator: Suspicious workflow detected - $(workflow_type) - Reason: $(reason)</description>
    <mitre>
      <id>T1204</id>
    </mitre>
    <group>suspicious_activity,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC7.2,</group>
  </rule>

  <!-- Workflow execution from unusual source -->
  <rule id="101013" level="7">
    <if_sid>101000</if_sid>
    <field name="msg">workflow execution</field>
    <field name="source_ip">^(?!10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)</field>
    <description>Workflow Orchestrator: Workflow execution from external IP $(srcip)</description>
    <group>suspicious_activity,external_access,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC7.2,</group>
  </rule>

  <!-- ========================================
       Rate Limiting and DoS
       ======================================== -->

  <!-- Rate limit exceeded -->
  <rule id="101020" level="6">
    <if_sid>101000</if_sid>
    <decoded_as>workflow-orchestrator-rate-limit</decoded_as>
    <description>Workflow Orchestrator: Rate limit exceeded from $(srcip)</description>
    <group>dos,rate_limit,pci_dss_11.4,gdpr_IV_35.7.d,nist_800_53_SI.4,tsc_CC6.1,tsc_CC7.2,</group>
  </rule>

  <!-- Multiple rate limit violations (potential DoS) -->
  <rule id="101021" level="10" frequency="10" timeframe="60">
    <if_matched_sid>101020</if_matched_sid>
    <same_source_ip />
    <description>Workflow Orchestrator: Potential DoS attack from $(srcip)</description>
    <mitre>
      <id>T1498</id>
    </mitre>
    <group>dos,attack,pci_dss_11.4,gdpr_IV_35.7.d,nist_800_53_SI.4,tsc_CC6.1,tsc_CC7.2,</group>
  </rule>

  <!-- Excessive workflow executions -->
  <rule id="101022" level="8" frequency="50" timeframe="300">
    <if_sid>101000</if_sid>
    <field name="msg">workflow execution started</field>
    <same_field>user_id</same_field>
    <description>Workflow Orchestrator: Excessive workflow executions from user $(user_id)</description>
    <mitre>
      <id>T1496</id>
    </mitre>
    <group>resource_abuse,dos,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC7.2,</group>
  </rule>

  <!-- ========================================
       Workflow Activity Failures
       ======================================== -->

  <!-- Activity failure -->
  <rule id="101030" level="5">
    <if_sid>101000</if_sid>
    <decoded_as>workflow-orchestrator-activity-failure</decoded_as>
    <description>Workflow Orchestrator: Activity failed - $(activity_name)</description>
    <group>workflow_error,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC7.2,</group>
  </rule>

  <!-- Multiple activity failures (potential attack or system issue) -->
  <rule id="101031" level="9" frequency="10" timeframe="300">
    <if_matched_sid>101030</if_matched_sid>
    <same_field>activity_name</same_field>
    <description>Workflow Orchestrator: Multiple failures for activity $(activity_name)</description>
    <group>workflow_error,service_availability,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC7.2,</group>
  </rule>

  <!-- Critical activity failure (ledger operations) -->
  <rule id="101032" level="10">
    <if_sid>101030</if_sid>
    <field name="activity_name">CreateTransfer|ProcessPayment|UpdateBalance</field>
    <description>Workflow Orchestrator: Critical activity failed - $(activity_name)</description>
    <group>workflow_error,critical,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC7.2,</group>
  </rule>

  <!-- ========================================
       Temporal Infrastructure Issues
       ======================================== -->

  <!-- Temporal connection error -->
  <rule id="101040" level="7">
    <if_sid>101000</if_sid>
    <decoded_as>workflow-orchestrator-temporal-error</decoded_as>
    <field name="error">connection|timeout|unavailable</field>
    <description>Workflow Orchestrator: Temporal connection error - $(error_message)</description>
    <group>temporal_error,infrastructure,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC7.2,</group>
  </rule>

  <!-- Multiple Temporal errors (infrastructure attack or outage) -->
  <rule id="101041" level="10" frequency="5" timeframe="180">
    <if_matched_sid>101040</if_matched_sid>
    <description>Workflow Orchestrator: Multiple Temporal errors detected</description>
    <group>temporal_error,infrastructure,service_availability,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC7.2,</group>
  </rule>

  <!-- ========================================
       Data Exfiltration and Suspicious Patterns
       ======================================== -->

  <!-- Workflow accessing multiple accounts -->
  <rule id="101050" level="8" frequency="20" timeframe="300">
    <if_sid>101000</if_sid>
    <field name="msg">workflow execution</field>
    <same_field>workflow_id</same_field>
    <different_field>account_id</different_field>
    <description>Workflow Orchestrator: Workflow accessing multiple accounts - $(workflow_id)</description>
    <mitre>
      <id>T1087</id>
      <id>T1213</id>
    </mitre>
    <group>data_access,enumeration,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC7.2,</group>
  </rule>

  <!-- Workflow execution outside business hours -->
  <rule id="101051" level="7">
    <if_sid>101000</if_sid>
    <field name="msg">workflow execution started</field>
    <time>00:00-06:00</time>
    <description>Workflow Orchestrator: Workflow execution outside business hours - $(workflow_type)</description>
    <group>suspicious_activity,off_hours,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC7.2,</group>
  </rule>

  <!-- Workflow with suspicious parameters -->
  <rule id="101052" level="9">
    <if_sid>101000</if_sid>
    <field name="msg">suspicious parameters detected</field>
    <description>Workflow Orchestrator: Workflow with suspicious parameters - $(workflow_type)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>suspicious_activity,injection,pci_dss_11.4,gdpr_IV_35.7.d,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,</group>
  </rule>

  <!-- ========================================
       Critical Alerts for OpenCTI Integration
       ======================================== -->

  <!-- Critical security events that should trigger OpenCTI integration -->
  <rule id="101080" level="12">
    <if_sid>101002,101004,101005,101011,101021,101041</if_sid>
    <description>Workflow Orchestrator: Critical security event - Trigger threat intelligence correlation</description>
    <group>critical,opencti_integration,</group>
  </rule>

  <!-- High-severity unauthorized execution -->
  <rule id="101081" level="12">
    <if_sid>101011</if_sid>
    <field name="workflow_type">AdminWorkflow|SystemMaintenance|BulkTransfer</field>
    <description>Workflow Orchestrator: Unauthorized execution of privileged workflow - $(workflow_type)</description>
    <mitre>
      <id>T1204</id>
      <id>T1078.004</id>
    </mitre>
    <group>critical,privileged_workflow,opencti_integration,</group>
  </rule>

</group>
