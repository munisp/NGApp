{
  "name": "enterprise-crm-novu-integration",
  "version": "1.0.0",
  "description": "Novu notification integration service for Enterprise CRM",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "npm run lint && npm test",
    "docker:build": "docker build -t enterprise-crm-novu .",
    "docker:run": "docker run -p 3001:3001 enterprise-crm-novu"
  },
  "keywords": [
    "novu",
    "notifications",
    "enterprise",
    "crm",
    "microservice"
  ],
  "author": "Enterprise CRM Team",
  "license": "MIT",
  "dependencies": {
    "@novu/node": "^0.24.0",
    "@novu/notification-center": "^0.24.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "redis": "^4.6.10",
    "pg": "^8.11.3",
    "axios": "^1.6.0",
    "uuid": "^9.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "rate-limiter-flexible": "^2.4.2",
    "compression": "^1.7.4",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enterprise-crm/novu-integration.git"
  },
  "bugs": {
    "url": "https://github.com/enterprise-crm/novu-integration/issues"
  },
  "homepage": "https://github.com/enterprise-crm/novu-integration#readme"
}

