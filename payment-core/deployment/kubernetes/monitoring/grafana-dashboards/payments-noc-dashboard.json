{
  "dashboard": {
    "id": null,
    "uid": "payments-noc",
    "title": "Payment Switch - NOC Dashboard",
    "tags": ["payments", "noc", "operations"],
    "timezone": "browser",
    "refresh": "5s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Current TPS",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(payment_switch_transactions_total[1m]))",
            "legendFormat": "TPS"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 100},
                {"color": "green", "value": 500}
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 2,
        "title": "Success Rate",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(payment_switch_transactions_total{status=\"success\"}[5m])) / sum(rate(payment_switch_transactions_total[5m])) * 100",
            "legendFormat": "Success %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 95},
                {"color": "green", "value": 99}
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 3,
        "title": "P99 Latency",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(payment_switch_transaction_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            },
            "unit": "s"
          }
        }
      },
      {
        "id": 4,
        "title": "Transactions In-Flight",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(payment_switch_transactions_in_flight)",
            "legendFormat": "In-Flight"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1000},
                {"color": "red", "value": 5000}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Pending Settlements",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
        "targets": [
          {
            "expr": "payment_switch_settlements_pending",
            "legendFormat": "Pending"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 100},
                {"color": "red", "value": 500}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Fraud Alerts",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
        "targets": [
          {
            "expr": "payment_switch_fraud_alerts_open",
            "legendFormat": "Open Alerts"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 50}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Transaction Volume (Last 24h)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "sum(rate(payment_switch_transactions_total[5m])) by (status)",
            "legendFormat": "{{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Latency Distribution",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "sum(rate(payment_switch_transaction_duration_seconds_bucket[5m])) by (le)",
            "legendFormat": "{{le}}"
          }
        ]
      },
      {
        "id": 9,
        "title": "Participant Health",
        "type": "table",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "payment_switch_participant_health",
            "legendFormat": "{{participant_name}}",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "participant_name": "Participant",
                "Value": "Health"
              }
            }
          }
        ]
      },
      {
        "id": 10,
        "title": "Participant TPS",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
        "targets": [
          {
            "expr": "topk(10, payment_switch_participant_tps)",
            "legendFormat": "{{participant_name}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 11,
        "title": "Transaction Amount Distribution",
        "type": "histogram",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
        "targets": [
          {
            "expr": "sum(rate(payment_switch_transaction_amount_bucket[5m])) by (le, currency)",
            "legendFormat": "{{currency}}"
          }
        ]
      },
      {
        "id": 12,
        "title": "TigerBeetle Cluster Health",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "tigerbeetle_cluster_health",
            "legendFormat": "Health"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "UNHEALTHY", "color": "red"}}},
              {"type": "value", "options": {"1": {"text": "HEALTHY", "color": "green"}}}
            ]
          }
        }
      },
      {
        "id": 13,
        "title": "TigerBeetle TPS",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 4, "y": 20},
        "targets": [
          {
            "expr": "tigerbeetle_transfers_per_second",
            "legendFormat": "TPS"
          }
        ]
      },
      {
        "id": 14,
        "title": "TigerBeetle Pending Transfers",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 8, "y": 20},
        "targets": [
          {
            "expr": "tigerbeetle_pending_transfers",
            "legendFormat": "Pending"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 100},
                {"color": "red", "value": 1000}
              ]
            }
          }
        }
      },
      {
        "id": 15,
        "title": "Mojaloop Transfers",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "sum(rate(mojaloop_transfers_total[5m])) by (status)",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "id": 16,
        "title": "Mojaloop Participant Positions",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "mojaloop_participant_position",
            "legendFormat": "{{fsp_id}}"
          }
        ],
        "options": {
          "orientation": "horizontal"
        }
      },
      {
        "id": 17,
        "title": "Kafka Consumer Lag",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "sum(payment_switch_kafka_consumer_lag) by (topic)",
            "legendFormat": "{{topic}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 10000},
                {"color": "red", "value": 100000}
              ]
            }
          }
        }
      },
      {
        "id": 18,
        "title": "Kill Switches Active",
        "type": "table",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "payment_switch_kill_switch_active == 1",
            "legendFormat": "{{switch_id}}",
            "format": "table",
            "instant": true
          }
        ]
      }
    ]
  }
}
