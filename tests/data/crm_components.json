        "component_code": "import React, { useState, useEffect, useMemo, createContext, useContext } from 'react';\nimport { motion } from 'framer-motion';\nimport { Button } from './ui/button';\nimport { Card, CardContent, CardHeader, CardTitle } from './ui/card';\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from './ui/tabs';\nimport { Input } from './ui/input';\nimport { Sheet, SheetContent, SheetHeader, SheetTitle, SheetTrigger } from './ui/sheet';\nimport { Sun, Moon, Search, Filter, SortAsc, SortDesc, PlusCircle, Loader2 } from 'lucide-react';\nimport { mockLeads, mockOpportunities, pipelineStages } from '../lib/mockData';\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from './ui/table';\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger, DialogFooter } from './ui/dialog';\nimport { Label } from './ui/label';\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from './ui/select';\nimport { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';\n\n// Context Providers\nconst ThemeContext = createContext(null);\nconst AuthContext = createContext(null);\nconst NotificationContext = createContext(null);\n\nconst ThemeProvider = ({ children }) => {\n  const [theme, setTheme] = useState('light');\n\n  useEffect(() => {\n    document.documentElement.classList.remove('light', 'dark');\n    document.documentElement.classList.add(theme);\n  }, [theme]);\n\n  const toggleTheme = () => {\n    setTheme((prevTheme) => (prevTheme === 'light' ? 'dark' : 'light'));\n  };\n\n  return (\n    <ThemeContext.Provider value={{ theme, toggleTheme }}>\n      {children}\n    </ThemeContext.Provider>\n  );\n};\n\nconst AuthProvider = ({ children }) => {\n  const currentUser = { name: 'Manus AI', role: 'Admin' }; // Mock authenticated user\n  return (\n    <AuthContext.Provider value={{ currentUser }}>\n      {children}\n    </AuthContext.Provider>\n  );\n};\n\nconst NotificationProvider = ({ children }) => {\n  const showNotification = (message, type = 'info') => {\n    console.log(`Notification (${type}): ${message}`);\n    // In a real app, this would trigger a toast/snackbar notification\n  };\n  return (\n    <NotificationContext.Provider value={{ showNotification }}>\n      {children}\n    </NotificationContext.Provider>\n  );\n};\n\nconst CrmCoreComponent = () => {\n  const { theme, toggleTheme } = useContext(ThemeContext);\n  const { currentUser } = useContext(AuthContext);\n  const { showNotification } = useContext(NotificationContext);\n\n  const [leads, setLeads] = useState([]);\n  const [opportunities, setOpportunities] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(null);\n\n  const [leadSearchTerm, setLeadSearchTerm] = useState('');\n  const [opportunitySearchTerm, setOpportunitySearchTerm] = useState('');\n  const [leadSortKey, setLeadSortKey] = useState(null);\n  const [leadSortDirection, setLeadSortDirection] = useState('asc');\n  const [opportunitySortKey, setOpportunitySortKey] = useState(null);\n  const [opportunitySortDirection, setOpportunitySortDirection] = useState('asc');\n  const [isLeadModalOpen, setIsLeadModalOpen] = useState(false);\n  const [isOpportunityModalOpen, setIsOpportunityModalOpen] = useState(false);\n  const [newLead, setNewLead] = useState({ name: '', company: '', status: 'New', email: '', phone: '', source: '' });\n  const [newOpportunity, setNewOpportunity] = useState({ name: '', account: '', stage: 'Qualification', amount: 0, closeDate: '', owner: '' });\n\n  useEffect(() => {\n    const fetchData = async () => {\n      try {\n        setLoading(true);\n        setError(null);\n        // Simulate API call\n        await new Promise(resolve => setTimeout(resolve, 1000));\n        setLeads(mockLeads);\n        setOpportunities(mockOpportunities);\n        showNotification('Data loaded successfully!', 'success');\n      } catch (err) {\n        setError('Failed to load data.');\n        showNotification('Failed to load data.', 'error');\n      } finally {\n        setLoading(false);\n      }\n    };\n    fetchData();\n  }, []);\n\n  const filteredAndSortedLeads = useMemo(() => {\n    let filtered = leads.filter(lead =>\n      lead.name.toLowerCase().includes(leadSearchTerm.toLowerCase()) ||\n      lead.company.toLowerCase().includes(leadSearchTerm.toLowerCase()) ||\n      lead.status.toLowerCase().includes(leadSearchTerm.toLowerCase())\n    );\n\n    if (leadSortKey) {\n      filtered.sort((a, b) => {\n        const aValue = a[leadSortKey];\n        const bValue = b[leadSortKey];\n\n        if (typeof aValue === 'string') {\n          return leadSortDirection === 'asc' ? aValue.localeCompare(bValue) : bValue.localeCompare(aValue);\n        } else if (typeof aValue === 'number') {\n          return leadSortDirection === 'asc' ? aValue - bValue : bValue - aValue;\n        }\n        return 0;\n      });\n    }\n    return filtered;\n  }, [leads, leadSearchTerm, leadSortKey, leadSortDirection]);\n\n  const filteredAndSortedOpportunities = useMemo(() => {\n    let filtered = opportunities.filter(opportunity =>\n      opportunity.name.toLowerCase().includes(opportunitySearchTerm.toLowerCase()) ||\n      opportunity.account.toLowerCase().includes(opportunitySearchTerm.toLowerCase()) ||\n      opportunity.stage.toLowerCase().includes(opportunitySearchTerm.toLowerCase())\n    );\n\n    if (opportunitySortKey) {\n      filtered.sort((a, b) => {\n        const aValue = a[opportunitySortKey];\n        const bValue = b[opportunitySortKey];\n\n        if (typeof aValue === 'string') {\n          return opportunitySortDirection === 'asc' ? aValue.localeCompare(bValue) : bValue.localeCompare(aValue);\n        } else if (typeof aValue === 'number') {\n          return opportunitySortDirection === 'asc' ? aValue - bValue : bValue - aValue;\n        }\n        return 0;\n      });\n    }\n    return filtered;\n  }, [opportunities, opportunitySearchTerm, opportunitySortKey, opportunitySortDirection]);\n\n  const handleLeadSort = (key) => {\n    if (leadSortKey === key) {\n      setLeadSortDirection(leadSortDirection === 'asc' ? 'desc' : 'asc');\n    } else {\n      setLeadSortKey(key);\n      setLeadSortDirection('asc');\n    }\n  };\n\n  const handleOpportunitySort = (key) => {\n    if (opportunitySortKey === key) {\n      setOpportunitySortDirection(opportunitySortDirection === 'asc' ? 'desc' : 'asc');\n    } else {\n      setOpportunitySortKey(key);\n      setOpportunitySortDirection('asc');\n    }\n  };\n\n  const handleAddLead = () => {\n    const newId = String(leads.length + 1);\n    const today = new Date().toISOString().slice(0, 10);\n    setLeads([...leads, { ...newLead, id: newId, created: today }]);\n    setNewLead({ name: '', company: '', status: 'New', email: '', phone: '', source: '' });\n    setIsLeadModalOpen(false);\n    showNotification('Lead added successfully!', 'success');\n  };\n\n  const handleAddOpportunity = () => {\n    const newId = String(opportunities.length + 101);\n    const today = new Date().toISOString().slice(0, 10);\n    setOpportunities([...opportunities, { ...newOpportunity, id: newId, created: today, amount: Number(newOpportunity.amount) }]);\n    setNewOpportunity({ name: '', account: '', stage: 'Qualification', amount: 0, closeDate: '', owner: '' });\n    setIsOpportunityModalOpen(false);\n    showNotification('Opportunity added successfully!', 'success');\n  };\n\n  const pipelineData = useMemo(() => {\n    const data = pipelineStages.map(stage => ({\n      name: stage.name,\n      opportunities: opportunities.filter(opp => opp.stage === stage.name).length,\n      totalAmount: opportunities.filter(opp => opp.stage === stage.name).reduce((sum, opp) => sum + opp.amount, 0),\n    }));\n    return data;\n  }, [opportunities]);\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen flex items-center justify-center bg