# KYC Service Configuration
SERVICE_NAME=kyc-service
SERVICE_PORT=8015

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kyc_db

# Redis
REDIS_URL=redis://localhost:6379/10

# BVN Verification Provider
BVN_PROVIDER_URL=https://api.nibss.com.ng/bvn
BVN_API_KEY=your-bvn-api-key

# NIN Verification Provider
NIN_PROVIDER_URL=https://api.nimc.gov.ng/nin
NIN_API_KEY=your-nin-api-key

# Liveness Check Provider (Smile ID, Onfido, etc.)
LIVENESS_PROVIDER=smile_id
SMILE_ID_API_KEY=your-smile-id-api-key
SMILE_ID_PARTNER_ID=your-partner-id

# Document Storage
DOCUMENT_STORAGE_URL=https://storage.example.com
DOCUMENT_STORAGE_KEY=your-storage-key

# Tier Limits (NGN)
TIER_1_DAILY_LIMIT=50000
TIER_2_DAILY_LIMIT=500000
TIER_3_DAILY_LIMIT=2000000
TIER_4_DAILY_LIMIT=10000000

# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256

# Service URLs
COMPLIANCE_SERVICE_URL=http://compliance-service:8011
NOTIFICATION_SERVICE_URL=http://notification-service:8007
