# =============================================================================
# NGApp CRM Platform — Environment Configuration
# Copy this file to .env and fill in the values.
# =============================================================================

# --- Database (Postgres) ---
DATABASE_URL=postgres://ndsep_user:YOUR_PASSWORD@localhost:5432/ndsep_db
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_USER=ndsep_user
POSTGRES_DB=ndsep_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --- Server ---
PORT=8080
ENVIRONMENT=development
READ_TIMEOUT=15
WRITE_TIMEOUT=15
IDLE_TIMEOUT=60

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Authentication (Keycloak) ---
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=crm
KEYCLOAK_CLIENT_ID=crm-web
KEYCLOAK_ADMIN_PASSWORD=YOUR_KEYCLOAK_ADMIN_PASSWORD

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=crm-services

# --- OpenSearch ---
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_ADMIN_PASSWORD=YOUR_OPENSEARCH_PASSWORD

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# --- Mojaloop ---
MOJALOOP_HOST=http://localhost:4000
MOJALOOP_HUB_NAME=hub

# --- TigerBeetle ---
TIGERBEETLE_ADDRESS=localhost:3000
TIGERBEETLE_CLUSTER_ID=0

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# --- Frontend ---
VITE_API_BASE=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws
