{
  "dashboard": {
    "title": "Middleware & Infrastructure",
    "uid": "middleware-dashboard",
    "tags": ["middleware", "infrastructure", "production"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "title": "Kafka Consumer Lag",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
        "targets": [{"expr": "kafka_consumer_group_lag{group=~\"crm-.*\"}", "legendFormat": "{{topic}} - {{group}}"}]
      },
      {
        "title": "Redis Memory Usage",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
        "targets": [{"expr": "redis_memory_used_bytes / redis_memory_max_bytes * 100", "legendFormat": "Memory %"}]
      },
      {
        "title": "Postgres Connections",
        "type": "stat",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
        "targets": [{"expr": "pg_stat_activity_count", "legendFormat": "Active Connections"}]
      },
      {
        "title": "Temporal Workflow Executions",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [{"expr": "rate(temporal_workflow_completed_total[5m])", "legendFormat": "{{workflow_type}}"}]
      },
      {
        "title": "OpenSearch Query Latency",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [{"expr": "histogram_quantile(0.95, rate(opensearch_query_duration_seconds_bucket[5m]))", "legendFormat": "p95"}]
      },
      {
        "title": "TigerBeetle Transactions/sec",
        "type": "stat",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
        "targets": [{"expr": "rate(tigerbeetle_transfers_total[5m])", "legendFormat": "tx/s"}]
      },
      {
        "title": "Keycloak Auth Requests",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
        "targets": [{"expr": "rate(keycloak_login_attempts_total[5m])", "legendFormat": "{{realm}} {{outcome}}"}]
      },
      {
        "title": "APISIX Gateway Throughput",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
        "targets": [{"expr": "rate(apisix_http_requests_total[5m])", "legendFormat": "{{route}}"}]
      }
    ]
  }
}
