# CRM Platform Environment Variables
# Copy to .env and update values for your environment

# Database
POSTGRES_USER=ndsep_user
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-changeme_in_production}
POSTGRES_DB=ndsep_db

# Keycloak Auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD:-changeme_in_production}

# Neo4j
NEO4J_PASSWORD=${NEO4J_PASSWORD:-changeme_in_production}

# OpenSearch
OPENSEARCH_INITIAL_ADMIN_PASSWORD=${OPENSEARCH_ADMIN_PASSWORD:-changeme_in_production}

# CORS
CORS_ALLOWED_ORIGINS=https://crm.platform.ng,https://*.crm.platform.ng,http://localhost:5173,http://localhost:3000

# API Gateway
APISIX_ADMIN_KEY=${APISIX_ADMIN_KEY:-changeme_in_production}

# TigerBeetle
TIGERBEETLE_CLUSTER_ID=0

# Permify
PERMIFY_ADMIN_TOKEN=${PERMIFY_ADMIN_TOKEN:-changeme_in_production}
