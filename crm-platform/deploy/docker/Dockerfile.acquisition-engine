FROM golang:1.21-alpine AS builder
WORKDIR /app
COPY crm-platform/services/go/acquisition-engine/ .
RUN go mod download && go build -o /acquisition-engine .

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /acquisition-engine /usr/local/bin/
EXPOSE 8086
CMD ["acquisition-engine"]
