{
  "dashboard": {
    "title": "Payment Switch — Business KPI Dashboard",
    "uid": "payment-switch-business-kpis",
    "version": 1,
    "timezone": "Africa/Lagos",
    "refresh": "30s",
    "panels": [
      {
        "title": "Revenue per Hour (₦)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [{ "expr": "sum(rate(transaction_fee_ngn_total[1h]))", "legendFormat": "Revenue/hr" }]
      },
      {
        "title": "Transaction Success Rate (%)",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
        "targets": [{ "expr": "sum(rate(nip_transactions_total{status='success'}[5m])) / sum(rate(nip_transactions_total[5m])) * 100" }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 95, "color": "yellow" },
                { "value": 99, "color": "green" }
              ]
            },
            "min": 90, "max": 100
          }
        }
      },
      {
        "title": "Current TPS",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "targets": [{ "expr": "sum(rate(nip_transactions_total[1m]))" }]
      },
      {
        "title": "Average Settlement Time (ms)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
        "targets": [{ "expr": "histogram_quantile(0.50, rate(nip_latency_bucket[5m]))" }]
      },
      {
        "title": "Volume by Bank (Top 10)",
        "type": "barchart",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [{ "expr": "topk(10, sum by (bank) (rate(nip_transactions_total[1h])))" }]
      },
      {
        "title": "Fraud Catch Rate (%)",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
        "targets": [{ "expr": "sum(rate(fraud_detected_total[24h])) / sum(rate(fraud_attempts_total[24h])) * 100" }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 80, "color": "yellow" },
                { "value": 95, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "title": "SLA Compliance (%)",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
        "targets": [{ "expr": "sum(rate(nip_transactions_total{latency_sla='met'}[24h])) / sum(rate(nip_transactions_total[24h])) * 100" }]
      },
      {
        "title": "Revenue by Product",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
        "targets": [{ "expr": "sum by (product) (transaction_fee_ngn_total)", "legendFormat": "{{product}}" }]
      },
      {
        "title": "Daily Transaction Value (₦B)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
        "targets": [{ "expr": "sum(increase(transaction_value_ngn_total[24h])) / 1e9" }]
      },
      {
        "title": "Active Incidents",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 16, "y": 16 },
        "targets": [{ "expr": "count(active_incidents)" }],
        "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "red" }] } } }
      },
      {
        "title": "MTTR (minutes)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 20, "y": 16 },
        "targets": [{ "expr": "avg(incident_mttr_minutes)" }]
      },
      {
        "title": "Corridor Volume Heatmap",
        "type": "heatmap",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
        "targets": [{ "expr": "sum by (corridor, hour) (rate(transaction_total[1h]))" }]
      },
      {
        "title": "Region Health",
        "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
        "targets": [{ "expr": "region_health_score" }]
      }
    ]
  }
}
