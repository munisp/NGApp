{
  "index_patterns": ["ngapp-logs-*"],
  "template": {
    "settings": {
      "number_of_shards": 2,
      "number_of_replicas": 1,
      "index.lifecycle.name": "ngapp-log-policy",
      "index.lifecycle.rollover_alias": "ngapp-logs"
    },
    "mappings": {
      "properties": {
        "timestamp": { "type": "date" },
        "service": { "type": "keyword" },
        "level": { "type": "keyword" },
        "message": { "type": "text" },
        "request_id": { "type": "keyword" },
        "tenant_id": { "type": "keyword" },
        "user_id": { "type": "keyword" },
        "method": { "type": "keyword" },
        "path": { "type": "keyword" },
        "status_code": { "type": "integer" },
        "duration_ms": { "type": "integer" },
        "error": { "type": "text" },
        "stack_trace": { "type": "text" },
        "metadata": { "type": "object", "dynamic": true }
      }
    }
  }
}
