# ============================================================================
# Document Intelligence Platform - Local-First Configuration
# ============================================================================

# ============================================================================
# Service Mode Configuration (local = default and preferred)
# ============================================================================

# DeepSeek Configuration
DEEPSEEK_MODE=local
DEEPSEEK_LOCAL_URL=http://localhost:9002
DEEPSEEK_MODEL_PATH=/models/deepseek-vl-7b-chat
DEEPSEEK_QUANTIZATION=int4
DEEPSEEK_MAX_BATCH_SIZE=8

# Docling Configuration
DOCLING_ENABLED=true
DOCLING_URL=http://localhost:9001
DOCLING_DEFAULT_FORMAT=markdown
DOCLING_ENABLE_TABLE_EXTRACTION=true

# Biometric Configuration
BIOMETRIC_MODE=local
BIOMETRIC_URL=http://localhost:9004
FACE_MATCH_THRESHOLD=0.6
LIVENESS_THRESHOLD=0.5
FACE_DETECTION_MODEL=mtcnn
FACE_RECOGNITION_MODEL=facenet

# NIMC Configuration (Nigerian National Identity Management Commission)
NIMC_MODE=local
NIMC_URL=http://localhost:9005
NIMC_USE_MOCK=false
NIMC_ENVIRONMENT=production
NIMC_API_URL=https://api.nimc.gov.ng/v1
NIMC_API_KEY=your_nimc_api_key_here
NIMC_API_SECRET=your_nimc_api_secret_here
NIMC_TIMEOUT=30
NIMC_RETRY_COUNT=3

# CAC Configuration (Corporate Affairs Commission)
CAC_MODE=local
CAC_URL=http://localhost:9006
CAC_USE_MOCK=false
CAC_ENVIRONMENT=production
CAC_API_URL=https://api.cac.gov.ng/v1
CAC_API_KEY=your_cac_api_key_here
CAC_API_SECRET=your_cac_api_secret_here
CAC_TIMEOUT=30
CAC_RETRY_COUNT=3

# ============================================================================
# OCR Service Priority (first = highest priority)
# ============================================================================
OCR_SERVICE_PRIORITY=deepseek_local,docling,tesseract,paddleocr

# ============================================================================
# Orchestration Configuration
# ============================================================================
ORCHESTRATOR_URL=http://localhost:9003
ORCHESTRATOR_WORKERS=10
ORCHESTRATOR_QUEUE_SIZE=1000

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/document_intelligence

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# API URLs (Internal)
# ============================================================================
BACKEND_API_URL=http://localhost:8001
ORCHESTRATION_API_URL=http://localhost:8003
FRONTEND_URL=http://localhost:3000

# ============================================================================
# Resource Limits
# ============================================================================
MAX_FILE_SIZE=50MB
MAX_BATCH_SIZE=100
MAX_CONCURRENT_REQUESTS=50

# ============================================================================
# Security Configuration
# ============================================================================
JWT_SECRET=your_jwt_secret_here
API_KEY_SALT=your_api_key_salt_here
HMAC_SECRET=your_hmac_secret_here

# ============================================================================
# Monitoring Configuration
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/document_intelligence/app.log

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_BIOMETRIC_VERIFICATION=true
ENABLE_NIN_VERIFICATION=true
ENABLE_RC_VERIFICATION=true
ENABLE_LIVENESS_DETECTION=true
ENABLE_DOCUMENT_TEMPLATES=true
ENABLE_SCHEDULED_EXPORTS=true
ENABLE_BATCH_PROCESSING=true

# ============================================================================
# Cloud Fallback Configuration (Optional - Disabled by Default)
# ============================================================================
ENABLE_CLOUD_FALLBACK=false
CLOUD_OCR_API_KEY=
CLOUD_BIOMETRIC_API_KEY=
CLOUD_FALLBACK_TIMEOUT=5000

# ============================================================================
# Performance Tuning
# ============================================================================
GPU_MEMORY_FRACTION=0.8
WORKER_THREADS=4
QUEUE_TIMEOUT=300
REQUEST_TIMEOUT=60

# ============================================================================
# Compliance and Privacy
# ============================================================================
DATA_RETENTION_DAYS=90
ENABLE_AUDIT_LOGGING=true
ENABLE_ENCRYPTION_AT_REST=true
ENABLE_PII_MASKING=true

# ============================================================================
# Development/Testing Configuration
# ============================================================================
DEBUG_MODE=false
ENABLE_MOCK_SERVICES=false
ENABLE_TEST_ENDPOINTS=false
