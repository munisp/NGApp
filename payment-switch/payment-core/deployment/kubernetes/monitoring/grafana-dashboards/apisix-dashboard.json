{
  "dashboard": {
    "id": null,
    "uid": "apisix-gateway",
    "title": "Payment Switch - APISIX Gateway",
    "tags": ["apisix", "gateway", "api"],
    "timezone": "browser",
    "refresh": "5s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Total Requests/sec",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(apisix_http_requests_total[1m]))",
            "legendFormat": "RPS"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 5000},
                {"color": "red", "value": 10000}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Success Rate",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
        "targets": [
          {
            "expr": "(sum(rate(apisix_http_requests_total{code=~\"2..\"}[5m])) / sum(rate(apisix_http_requests_total[5m]))) * 100",
            "legendFormat": "Success %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 95},
                {"color": "green", "value": 99}
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 3,
        "title": "P99 Latency",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(apisix_http_latency_bucket[5m])) by (le))",
            "legendFormat": "P99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 100},
                {"color": "red", "value": 500}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Active Connections",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(apisix_nginx_http_current_connections{state=\"active\"})",
            "legendFormat": "Active"
          }
        ]
      },
      {
        "id": 5,
        "title": "4xx Errors/sec",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(apisix_http_requests_total{code=~\"4..\"}[1m]))",
            "legendFormat": "4xx"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 100}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "5xx Errors/sec",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(apisix_http_requests_total{code=~\"5..\"}[1m]))",
            "legendFormat": "5xx"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 10}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Request Rate by Route",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "sum(rate(apisix_http_requests_total[5m])) by (route)",
            "legendFormat": "{{route}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Latency by Route",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(apisix_http_latency_bucket[5m])) by (le, route))",
            "legendFormat": "{{route}} P95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        }
      },
      {
        "id": 9,
        "title": "Response Status Codes",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "sum(rate(apisix_http_requests_total[1h])) by (code)",
            "legendFormat": "{{code}}"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right"
          }
        }
      },
      {
        "id": 10,
        "title": "Upstream Health",
        "type": "table",
        "gridPos": {"h": 8, "w": 10, "x": 6, "y": 12},
        "targets": [
          {
            "expr": "apisix_upstream_status",
            "legendFormat": "{{upstream}}",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "upstream": "Upstream",
                "Value": "Status"
              }
            }
          }
        ]
      },
      {
        "id": 11,
        "title": "Rate Limiting",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
        "targets": [
          {
            "expr": "sum(rate(apisix_http_requests_total{code=\"429\"}[5m])) by (route)",
            "legendFormat": "{{route}} (429)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 2
            }
          }
        }
      },
      {
        "id": 12,
        "title": "Bandwidth In/Out",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "sum(rate(apisix_bandwidth{type=\"ingress\"}[5m]))",
            "legendFormat": "Ingress"
          },
          {
            "expr": "sum(rate(apisix_bandwidth{type=\"egress\"}[5m]))",
            "legendFormat": "Egress"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps"
          }
        }
      },
      {
        "id": 13,
        "title": "Plugin Execution Time",
        "type": "heatmap",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "sum(rate(apisix_plugin_latency_bucket[5m])) by (le, plugin)",
            "legendFormat": "{{plugin}}"
          }
        ]
      },
      {
        "id": 14,
        "title": "Security Plugin Stats",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 26},
        "targets": [
          {
            "expr": "sum(rate(apisix_http_requests_total{plugin=\"security-middleware\"}[5m]))",
            "legendFormat": "Security Checks"
          },
          {
            "expr": "sum(rate(apisix_http_requests_total{plugin=\"openappsec\"}[5m]))",
            "legendFormat": "WAF Checks"
          }
        ]
      },
      {
        "id": 15,
        "title": "JWT Auth Stats",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 26},
        "targets": [
          {
            "expr": "sum(rate(apisix_http_requests_total{plugin=\"jwt-auth\",code=\"200\"}[5m]))",
            "legendFormat": "Auth Success"
          },
          {
            "expr": "sum(rate(apisix_http_requests_total{plugin=\"jwt-auth\",code=\"401\"}[5m]))",
            "legendFormat": "Auth Failed"
          }
        ]
      },
      {
        "id": 16,
        "title": "Connection Pool",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 26},
        "targets": [
          {
            "expr": "apisix_nginx_http_current_connections",
            "legendFormat": "{{state}}"
          }
        ]
      }
    ]
  }
}
