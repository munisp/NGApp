{
  "automation_rules": [
    {
      "name": "Auto-assign Wazuh Critical Alerts",
      "description": "Automatically assign critical Wazuh alerts to the security team",
      "enabled": true,
      "trigger": {
        "type": "incident_created",
        "filters": [
          {
            "key": "severity",
            "values": ["critical"],
            "operator": "eq"
          },
          {
            "key": "labels",
            "values": ["wazuh-alert"],
            "operator": "contains"
          }
        ]
      },
      "actions": [
        {
          "type": "assign",
          "assignee": "security-team@example.com"
        },
        {
          "type": "add_label",
          "label": "requires-immediate-action"
        }
      ]
    },
    {
      "name": "Auto-enrich IP Observables",
      "description": "Automatically enrich IP address observables from Wazuh alerts",
      "enabled": true,
      "trigger": {
        "type": "observable_created",
        "filters": [
          {
            "key": "type",
            "values": ["IPv4-Addr"],
            "operator": "eq"
          }
        ]
      },
      "actions": [
        {
          "type": "enrich",
          "enrichment_connectors": [
            "VirusTotal",
            "AbuseIPDB",
            "Shodan"
          ]
        }
      ]
    },
    {
      "name": "Create Case for Privilege Escalation",
      "description": "Automatically create a case for privilege escalation incidents",
      "enabled": true,
      "trigger": {
        "type": "incident_created",
        "filters": [
          {
            "key": "incident_type",
            "values": ["Privilege Escalation"],
            "operator": "eq"
          }
        ]
      },
      "actions": [
        {
          "type": "create_case",
          "case_template": "privilege-escalation-investigation"
        },
        {
          "type": "add_label",
          "label": "high-priority"
        }
      ]
    },
    {
      "name": "Notify on Fraud Detection",
      "description": "Send notification when fraud is detected",
      "enabled": true,
      "trigger": {
        "type": "incident_created",
        "filters": [
          {
            "key": "incident_type",
            "values": ["Fraud Detection"],
            "operator": "eq"
          }
        ]
      },
      "actions": [
        {
          "type": "notify",
          "notification_channels": [
            "slack-security-channel",
            "email-fraud-team"
          ]
        }
      ]
    },
    {
      "name": "Block Malicious IPs",
      "description": "Automatically block IPs with high confidence indicators",
      "enabled": false,
      "trigger": {
        "type": "indicator_created",
        "filters": [
          {
            "key": "pattern_type",
            "values": ["stix"],
            "operator": "eq"
          },
          {
            "key": "confidence",
            "values": [80],
            "operator": "gte"
          },
          {
            "key": "x_opencti_main_observable_type",
            "values": ["IPv4-Addr"],
            "operator": "eq"
          }
        ]
      },
      "actions": [
        {
          "type": "execute_playbook",
          "playbook": "block-ip-firewall"
        }
      ]
    },
    {
      "name": "Correlate Related Incidents",
      "description": "Automatically correlate incidents from the same source IP",
      "enabled": true,
      "trigger": {
        "type": "incident_created",
        "filters": [
          {
            "key": "labels",
            "values": ["wazuh-alert"],
            "operator": "contains"
          }
        ]
      },
      "actions": [
        {
          "type": "correlate",
          "correlation_key": "source_ip",
          "time_window": 3600
        }
      ]
    },
    {
      "name": "Escalate Multiple Authentication Failures",
      "description": "Escalate severity when multiple authentication failures are detected",
      "enabled": true,
      "trigger": {
        "type": "incident_created",
        "filters": [
          {
            "key": "incident_type",
            "values": ["Authentication Failure"],
            "operator": "eq"
          },
          {
            "key": "severity",
            "values": ["high"],
            "operator": "eq"
          }
        ]
      },
      "actions": [
        {
          "type": "update_severity",
          "new_severity": "critical"
        },
        {
          "type": "add_label",
          "label": "potential-breach"
        }
      ]
    },
    {
      "name": "Tag PCI DSS Compliance Violations",
      "description": "Tag incidents that violate PCI DSS compliance",
      "enabled": true,
      "trigger": {
        "type": "incident_created",
        "filters": [
          {
            "key": "labels",
            "values": ["pci-dss"],
            "operator": "contains"
          }
        ]
      },
      "actions": [
        {
          "type": "add_label",
          "label": "compliance-violation"
        },
        {
          "type": "notify",
          "notification_channels": [
            "email-compliance-team"
          ]
        }
      ]
    }
  ]
}
