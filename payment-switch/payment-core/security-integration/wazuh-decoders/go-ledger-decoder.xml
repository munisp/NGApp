<!--
  Wazuh Custom Decoder for Go Ledger Service
  Parses structured JSON logs from the Go Ledger service
-->

<decoder name="go-ledger-json">
  <program_name>go-ledger</program_name>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<decoder name="go-ledger-json">
  <parent>go-ledger-json</parent>
  <use_own_name>true</use_own_name>
  <json_decoder>level</json_decoder>
  <json_decoder>msg</json_decoder>
  <json_decoder>time</json_decoder>
  <json_decoder>service</json_decoder>
  <json_decoder>transaction_id</json_decoder>
  <json_decoder>account_id</json_decoder>
  <json_decoder>amount</json_decoder>
  <json_decoder>currency</json_decoder>
  <json_decoder>operation</json_decoder>
  <json_decoder>source_ip</json_decoder>
  <json_decoder>user_id</json_decoder>
  <json_decoder>error</json_decoder>
  <json_decoder>status_code</json_decoder>
  <json_decoder>response_time_ms</json_decoder>
</decoder>

<decoder name="go-ledger-transfer">
  <parent>go-ledger-json</parent>
  <prematch>transfer</prematch>
  <regex offset="after_parent">\"operation\":\"(\w+)\".*\"from_account\":\"(\w+)\".*\"to_account\":\"(\w+)\".*\"amount\":(\d+)</regex>
  <order>operation,from_account,to_account,amount</order>
</decoder>

<decoder name="go-ledger-balance">
  <parent>go-ledger-json</parent>
  <prematch>balance</prematch>
  <regex offset="after_parent">\"operation\":\"(\w+)\".*\"account_id\":\"(\w+)\".*\"balance\":(\d+)</regex>
  <order>operation,account_id,balance</order>
</decoder>

<decoder name="go-ledger-error">
  <parent>go-ledger-json</parent>
  <prematch>error</prematch>
  <regex offset="after_parent">\"level\":\"error\".*\"error\":\"([^\"]+)\"</regex>
  <order>error_message</order>
</decoder>

<decoder name="go-ledger-auth-failure">
  <parent>go-ledger-json</parent>
  <prematch>authentication failed</prematch>
  <regex offset="after_parent">\"source_ip\":\"(\d+\.\d+\.\d+\.\d+)\".*\"user_id\":\"([^\"]+)\"</regex>
  <order>srcip,user</order>
</decoder>

<decoder name="go-ledger-rate-limit">
  <parent>go-ledger-json</parent>
  <prematch>rate limit exceeded</prematch>
  <regex offset="after_parent">\"source_ip\":\"(\d+\.\d+\.\d+\.\d+)\"</regex>
  <order>srcip</order>
</decoder>

<decoder name="go-ledger-suspicious-amount">
  <parent>go-ledger-json</parent>
  <prematch>large transaction</prematch>
  <regex offset="after_parent">\"amount\":(\d+).*\"currency\":\"(\w+)\"</regex>
  <order>amount,currency</order>
</decoder>
