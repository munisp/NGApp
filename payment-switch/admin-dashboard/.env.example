# Keycloak Configuration
NEXT_PUBLIC_KEYCLOAK_URL=http://keycloak.payment-switch.svc.cluster.local:8080
NEXT_PUBLIC_KEYCLOAK_REALM=payment-switch
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=admin-dashboard

# Permify Configuration
NEXT_PUBLIC_PERMIFY_URL=http://permify.payment-switch.svc.cluster.local:3476
NEXT_PUBLIC_PERMIFY_TENANT=payment-switch

# API Configuration (APISIX Gateway)
NEXT_PUBLIC_API_URL=http://apisix.payment-switch.svc.cluster.local:9080

# OpenAppSec WAF (configured at infrastructure level)
# No frontend configuration needed - WAF is deployed as ingress controller
