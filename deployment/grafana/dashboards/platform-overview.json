{
  "dashboard": {
    "id": null,
    "uid": "fintech-platform-overview",
    "title": "Fintech Platform Overview",
    "tags": ["fintech", "platform", "overview"],
    "timezone": "browser",
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Service Health",
        "type": "stat",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
        "targets": [{ "expr": "up", "legendFormat": "{{ job }}" }],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Kafka Messages Produced/s",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [
          { "expr": "rate(kafka_messages_produced_total[5m])", "legendFormat": "{{ topic }}" }
        ]
      },
      {
        "id": 3,
        "title": "Kafka Produce Latency (p95)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          { "expr": "histogram_quantile(0.95, rate(kafka_produce_latency_seconds_bucket[5m]))", "legendFormat": "p95" },
          { "expr": "histogram_quantile(0.50, rate(kafka_produce_latency_seconds_bucket[5m]))", "legendFormat": "p50" }
        ]
      },
      {
        "id": 4,
        "title": "Redis Operations/s",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          { "expr": "rate(redis_operations_total[5m])", "legendFormat": "{{ operation }}" }
        ]
      },
      {
        "id": 5,
        "title": "Redis Cache Hit Rate",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          { "expr": "rate(redis_cache_hits_total[5m]) / (rate(redis_cache_hits_total[5m]) + rate(redis_cache_misses_total[5m]))", "legendFormat": "Hit Rate" }
        ],
        "fieldConfig": { "defaults": { "max": 1, "min": 0, "unit": "percentunit" } }
      },
      {
        "id": 6,
        "title": "TigerBeetle Transfers/s",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
        "targets": [
          { "expr": "rate(tigerbeetle_transfers_total[5m])", "legendFormat": "transfers/s" }
        ]
      },
      {
        "id": 7,
        "title": "TigerBeetle Ledger Balance",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "targets": [
          { "expr": "tigerbeetle_ledger_balance", "legendFormat": "{{ ledger }} {{ type }}" }
        ]
      },
      {
        "id": 8,
        "title": "WAF Scans & Blocks/s",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
        "targets": [
          { "expr": "rate(openappsec_scans_total[5m])", "legendFormat": "scans/s" },
          { "expr": "rate(openappsec_blocked_total[5m])", "legendFormat": "blocked/s" }
        ]
      },
      {
        "id": 9,
        "title": "WAF Threats by Type",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
        "targets": [
          { "expr": "openappsec_threats_detected_total", "legendFormat": "{{ threat_type }}" }
        ]
      },
      {
        "id": 10,
        "title": "Fluvio Records Produced/s",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
        "targets": [
          { "expr": "rate(fluvio_records_produced_total[5m])", "legendFormat": "{{ topic }}" }
        ]
      },
      {
        "id": 11,
        "title": "ML Prediction Latency",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
        "targets": [
          { "expr": "histogram_quantile(0.95, rate(ml_prediction_latency_seconds_bucket[5m]))", "legendFormat": "p95" },
          { "expr": "histogram_quantile(0.50, rate(ml_prediction_latency_seconds_bucket[5m]))", "legendFormat": "p50" }
        ]
      },
      {
        "id": 12,
        "title": "Dead Letter Queue Size",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 0, "y": 44 },
        "targets": [{ "expr": "kafka_dlq_messages_total", "legendFormat": "DLQ" }],
        "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }] } } }
      },
      {
        "id": 13,
        "title": "Kafka Produce Errors/s",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 8, "y": 44 },
        "targets": [{ "expr": "rate(kafka_produce_errors_total[5m])", "legendFormat": "errors/s" }]
      },
      {
        "id": 14,
        "title": "WAF Scan Latency (p95)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 16, "y": 44 },
        "targets": [{ "expr": "histogram_quantile(0.95, rate(openappsec_scan_latency_seconds_bucket[5m]))", "legendFormat": "p95" }],
        "fieldConfig": { "defaults": { "unit": "s" } }
      }
    ]
  },
  "overwrite": true
}
