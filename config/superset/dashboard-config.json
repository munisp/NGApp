      "viz_type": "table",
      "params": {
        "groupby": ["campaign_name"],
        "metrics": ["count", "sum__cost", "avg__conversion_rate"],
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "subject": "status",
            "operator": "==",
            "comparator": "active"
          }
        ],
        "row_limit": 10,
        "order_desc": true,
        "orderby": [["sum__cost", false]]
      },
      "query_context": {
        "datasource": {
          "type": "table",
          "id": "marketing_campaigns"
        },
        "queries": [
          {
            "groupby": ["campaign_name"],
            "metrics": ["count", "sum__cost", "avg__conversion_rate"],
            "filters": [
              {
                "col": "status",
                "op": "==",
                "val": "active"
              }
            ],
            "row_limit": 10
          }
        ]
      }
    },
    {
