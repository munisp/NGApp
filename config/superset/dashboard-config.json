  "datasets": [
    {
      "table_name": "opportunities",
      "description": "Sales opportunities and deals",
      "sql": "SELECT * FROM opportunities WHERE deleted_at IS NULL",
      "columns": [
        {"column_name": "id", "type": "UUID"},
        {"column_name": "name", "type": "VARCHAR"},
        {"column_name": "amount", "type": "DECIMAL"},
        {"column_name": "stage", "type": "VARCHAR"},
        {"column_name": "status", "type": "VARCHAR"},
        {"column_name": "created_at", "type": "TIMESTAMP"},
        {"column_name": "close_date", "type": "DATE"}
      ],
      "metrics": [
        {
          "metric_name": "sum__amount",
          "expression": "SUM(amount)",
          "description": "Total opportunity amount"
        },
        {
          "metric_name": "count",
          "expression": "COUNT(*)",
          "description": "Number of opportunities"
        },
        {
          "metric_name": "avg__amount",
          "expression": "AVG(amount)",
          "description": "Average opportunity amount"
        }
      ]
    },
    {
      "table_name": "customers",
      "description": "Customer master data",
      "sql": "SELECT * FROM customers WHERE deleted_at IS NULL",
      "columns": [
        {"column_name": "id", "type": "UUID"},
        {"column_name": "name", "type": "VARCHAR"},
        {"column_name": "status", "type": "VARCHAR"},
        {"column_name": "segment", "type": "VARCHAR"},
        {"column_name": "tier", "type": "VARCHAR"},
        {"column_name": "created_at", "type": "TIMESTAMP"}
      ],
      "metrics": [
        {
          "metric_name": "count",
          "expression": "COUNT(*)",
          "description": "Number of customers"
        }
      ]
    },
    {
      "table_name": "leads",
      "description": "Sales leads and prospects",
      "sql": "SELECT * FROM leads WHERE deleted_at IS NULL",
      "columns": [
        {"column_name": "id", "type": "UUID"},
        {"column_name": "name", "type": "VARCHAR"},
        {"column_name": "status", "type": "VARCHAR"},
        {"column_name": "source", "type": "VARCHAR"},
        {"column_name": "score", "type": "INTEGER"},
        {"column_name": "created_at", "type": "TIMESTAMP"}
      ],
      "metrics": [
        {
          "metric_name": "count",
          "expression": "COUNT(*)",
          "description": "Number of leads"
        },
        {
          "metric_name": "avg__score",
          "expression": "AVG(score)",
          "description": "Average lead score"
        }
      ]
    },
    {
      "table_name": "stock_items",
      "description": "Current inventory stock levels",
      "sql": "SELECT * FROM stock_items WHERE deleted_at IS NULL",
      "columns": [
        {"column_name": "id", "type": "UUID"},
        {"column_name": "product_id", "type": "UUID"},
        {"column_name": "quantity_on_hand", "type": "INTEGER"},
        {"column_name": "quantity_reserved", "type": "INTEGER"},
        {"column_name": "unit_cost", "type": "DECIMAL"},
        {"column_name": "total_value", "type": "DECIMAL"}
      ],
      "metrics": [
        {
          "metric_name": "sum__total_value",
          "expression": "SUM(total_value)",
          "description": "Total inventory value"
        },
        {
          "metric_name": "sum__quantity_on_hand",
          "expression": "SUM(quantity_on_hand)",
          "description": "Total quantity on hand"
        },
        {
          "metric_name": "sum__quantity_reserved",
          "expression": "SUM(quantity_reserved)",
          "description": "Total quantity reserved"
        }
      ]
    }
  ],
