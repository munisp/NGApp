        "metrics": ["sum__amount"],
        "groupby": [],
        "granularity_sqla": "created_at",
        "time_grain_sqla": "P1M",
        "time_range": "Last 12 months",
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "subject": "status",
            "operator": "IN",
            "comparator": ["won", "closed_won"]
          }
        ],
        "line_interpolation": "linear",
        "show_markers": true,
        "y_axis_format": "$,.0f"
      },
      "query_context": {
        "datasource": {
          "type": "table",
          "id": "opportunities"
        },
        "queries": [
          {
            "metrics": ["sum__amount"],
            "granularity": "created_at",
            "time_range": "Last 12 months",
            "filters": [
              {
                "col": "status",
                "op": "IN",
                "val": ["won", "closed_won"]
              }
            ]
          }
        ]
