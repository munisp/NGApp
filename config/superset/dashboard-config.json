  "charts": [
    {
      "id": 1,
      "slice_name": "Total Revenue",
      "description": "Total revenue across all opportunities and sales",
      "viz_type": "big_number_total",
      "params": {
        "metric": "sum__amount",
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "subject": "status",
            "operator": "IN",
            "comparator": ["won", "closed_won"]
          }
        ],
        "granularity_sqla": "created_at",
        "time_range": "Last 12 months",
        "subheader": "Last 12 Months",
        "y_axis_format": "$,.0f"
      },
      "query_context": {
        "datasource": {
          "type": "table",
          "id": "opportunities"
        },
        "queries": [
          {
            "metrics": ["sum__amount"],
            "filters": [
              {
                "col": "status",
                "op": "IN",
                "val": ["won", "closed_won"]
              }
            ],
            "time_range": "Last 12 months"
          }
        ]
      }
    },
    {
      "id": 2,
      "slice_name": "Total Customers",
      "description": "Total number of active customers",
      "viz_type": "big_number_total",
      "params": {
        "metric": "count",
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "subject": "status",
            "operator": "==",
            "comparator": "active"
          }
        ],
        "subheader": "Active Customers",
        "y_axis_format": ",.0f"
      },
      "query_context": {
        "datasource": {
          "type": "table",
          "id": "customers"
        },
        "queries": [
          {
            "metrics": ["count"],
            "filters": [
              {
                "col": "status",
                "op": "==",
                "val": "active"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "slice_name": "Total Leads",
      "description": "Total number of leads in pipeline",
      "viz_type": "big_number_total",
      "params": {
        "metric": "count",
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "subject": "status",
            "operator": "IN",
            "comparator": ["new", "contacted", "qualified"]
          }
        ],
        "subheader": "Active Leads",
        "y_axis_format": ",.0f"
      },
      "query_context": {
        "datasource": {
          "type": "table",
          "id": "leads"
        },
        "queries": [
          {
            "metrics": ["count"],
            "filters": [
              {
                "col": "status",
                "op": "IN",
                "val": ["new", "contacted", "qualified"]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "slice_name": "Inventory Value",
      "description": "Total value of current inventory",
      "viz_type": "big_number_total",
      "params": {
        "metric": "sum__total_value",
        "subheader": "Current Inventory",
        "y_axis_format": "$,.0f"
      },
      "query_context": {
        "datasource": {
          "type": "table",
          "id": "stock_items"
        },
        "queries": [
          {
            "metrics": ["sum__total_value"]
          }
        ]
      }
    },
    {
      "id": 5,
      "slice_name": "Sales Pipeline by Stage",
      "description": "Opportunities distribution across pipeline stages",
      "viz_type": "pie",
      "params": {
        "groupby": ["stage"],
        "metric": "sum__amount",
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "subject": "status",
            "operator": "IN",
            "comparator": ["open", "in_progress"]
          }
        ],
        "donut": true,
        "show_legend": true,
        "legend_position": "right",
        "color_scheme": "supersetColors"
      },
      "query_context": {
        "datasource": {
          "type": "table",
          "id": "opportunities"
        },
        "queries": [
          {
            "groupby": ["stage"],
            "metrics": ["sum__amount"],
            "filters": [
              {
                "col": "status",
                "op": "IN",
                "val": ["open", "in_progress"]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "slice_name": "Lead Conversion Funnel",
      "description": "Lead to customer conversion funnel",
      "viz_type": "funnel",
      "params": {
        "groupby": ["stage"],
        "metric": "count",
        "adhoc_filters": [],
