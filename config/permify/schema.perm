// Permify Authorization Schema for Payment Switch Platform
// Defines entities, relations, and permissions for fine-grained access control

entity user {}

entity organization {
    // Relations
    relation admin @user
    relation operator @user
    relation auditor @user
    relation member @user

    // Permissions
    permission view = admin or operator or auditor or member
    permission edit = admin or operator
    permission delete = admin
    permission manage_users = admin
    permission view_audit = admin or auditor
}

entity merchant {
    // Relations
    relation organization @organization
    relation admin @user
    relation operator @user
    relation viewer @user

    // Permissions
    permission view = admin or operator or viewer or organization.admin or organization.operator or organization.auditor
    permission edit = admin or operator or organization.admin or organization.operator
    permission delete = admin or organization.admin
    permission manage_api_keys = admin or organization.admin
    permission view_transactions = admin or operator or viewer or organization.admin or organization.operator or organization.auditor
    permission process_refunds = admin or operator or organization.admin or organization.operator
    permission view_analytics = admin or operator or viewer or organization.admin or organization.operator
}

entity transaction {
    // Relations
    relation merchant @merchant
    relation creator @user

    // Permissions
    permission view = creator or merchant.view_transactions
    permission refund = merchant.process_refunds
    permission void = merchant.admin or merchant.organization.admin
}

entity payment_session {
    // Relations
    relation merchant @merchant
    relation customer @user

    // Permissions
    permission view = customer or merchant.view_transactions
    permission complete = customer
    permission cancel = customer or merchant.operator or merchant.admin
}

entity api_key {
    // Relations
    relation merchant @merchant
    relation creator @user

    // Permissions
    permission view = creator or merchant.manage_api_keys
    permission revoke = merchant.manage_api_keys
    permission rotate = merchant.manage_api_keys
}

entity webhook {
    // Relations
    relation merchant @merchant
    relation creator @user

    // Permissions
    permission view = creator or merchant.admin or merchant.operator
    permission edit = creator or merchant.admin
    permission delete = merchant.admin
    permission test = creator or merchant.admin or merchant.operator
}

entity participant {
    // Financial institution participant
    relation organization @organization
    relation admin @user
    relation operator @user
    relation viewer @user

    // Permissions
    permission view = admin or operator or viewer or organization.admin or organization.auditor
    permission edit = admin or operator or organization.admin
    permission delete = admin or organization.admin
    permission manage_credentials = admin or organization.admin
    permission view_settlements = admin or operator or viewer or organization.admin or organization.auditor
    permission initiate_transfers = admin or operator or organization.admin or organization.operator
}

entity settlement {
    // Relations
    relation participant @participant
    relation creator @user

    // Permissions
    permission view = creator or participant.view_settlements
    permission approve = participant.admin or participant.organization.admin
    permission reject = participant.admin or participant.organization.admin
}

entity audit_log {
    // Relations
    relation organization @organization
    relation subject @user

    // Permissions
    permission view = organization.view_audit
    permission export = organization.admin or organization.auditor
}

entity report {
    // Relations
    relation organization @organization
    relation creator @user

    // Permissions
    permission view = creator or organization.admin or organization.operator or organization.auditor
    permission edit = creator or organization.admin
    permission delete = creator or organization.admin
    permission schedule = organization.admin or organization.operator
}

entity kyc_application {
    // Relations
    relation organization @organization
    relation applicant @user
    relation reviewer @user

    // Permissions
    permission view = applicant or reviewer or organization.admin or organization.operator
    permission submit = applicant
    permission review = reviewer or organization.admin or organization.operator
    permission approve = organization.admin
    permission reject = organization.admin or organization.operator
}

entity kyb_application {
    // Relations
    relation organization @organization
    relation applicant @user
    relation reviewer @user

    // Permissions
    permission view = applicant or reviewer or organization.admin or organization.operator
    permission submit = applicant
    permission review = reviewer or organization.admin or organization.operator
    permission approve = organization.admin
    permission reject = organization.admin or organization.operator
}

entity onboarding_application {
    // Relations
    relation organization @organization
    relation applicant @user
    relation reviewer @user

    // Permissions
    permission view = applicant or reviewer or organization.admin or organization.operator
    permission submit = applicant
    permission review = reviewer or organization.admin or organization.operator
    permission approve = organization.admin
    permission reject = organization.admin or organization.operator
    permission request_documents = reviewer or organization.admin or organization.operator
}
